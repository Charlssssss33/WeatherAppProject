<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ChrnProjectP511.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="ChrnProjectP511.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="ChrnProjectP511">

    <Design.DataContext>
        <!-- This only sets the DataContext for the previewer in an IDE,
             to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs) -->
        <vm:MainWindowViewModel/>
    </Design.DataContext>


     <Grid RowDefinitions="Auto,Auto,*,Auto">

        <Rectangle Grid.Row="0" Height="20"/>


        <Border Grid.Row="1" Margin="20,0">
            <TextBlock Text="🌦️ Weather App"
                       FontSize="28"
                       FontWeight="Bold"
                       Foreground="#F8FAFC"
                       HorizontalAlignment="Center"/>
        </Border>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="20" Spacing="15">

                <Border Background="#1E293B"
                        CornerRadius="12"
                        Padding="12">
                    <TextBox Text="{Binding CityName}"
                             Watermark="🏙️ Введите город"
                             Foreground="#F8FAFC"
                             Background="Transparent"
                             BorderThickness="0"
                             FontSize="16"/>
                </Border>

                <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                    <Button Grid.Column="0"
                            Command="{Binding SearchWeatherCommand}"
                            Content="🔍 Погода"
                            Background="#3B82F6"
                            Foreground="White"
                            FontWeight="Bold"
                            Padding="12"
                            CornerRadius="10"
                            FontSize="14"/>
                    
                    <Button Grid.Column="1"
                            Command="{Binding SaveDefaultCityCommand}"
                            Content="⭐ Запомнить"
                            Background="#8B5CF6"
                            Foreground="White"
                            FontWeight="Bold"
                            Padding="12"
                            CornerRadius="10"
                            FontSize="14"/>
                </Grid>

                <TextBlock Text="⏳ Загрузка погоды..."
                           Foreground="#94A3B8"
                           HorizontalAlignment="Center"
                           IsVisible="{Binding IsLoading}"
                           FontSize="13"/>

                <TextBlock Text="{Binding ErrorText}"
                           Foreground="#EF4444"
                           HorizontalAlignment="Center"
                           IsVisible="{Binding IsErrorVisible}"
                           FontSize="13"
                           FontWeight="Bold"/>

                <Border IsVisible="{Binding IsWeatherCardVisible}"
                        Background="#1E293B"
                        CornerRadius="20"
                        Padding="20">

                    <StackPanel Spacing="12">
                        <TextBlock Text="{Binding CityNameText}"
                                   FontSize="22"
                                   FontWeight="Bold"
                                   Foreground="#344ceb"
                                   HorizontalAlignment="Center"/>

                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Center"
                                    Spacing="8">
                            <TextBlock Text="{Binding IconText}"
                                       FontSize="56"/>
                            <TextBlock Text="{Binding TempText}"
                                       FontSize="56"
                                       FontWeight="Bold"
                                       Foreground="#F8FAFC"/>
                        </StackPanel>

                        <TextBlock Text="{Binding DescriptionText}"
                                   FontSize="16"
                                   Foreground="#94A3B8"
                                   HorizontalAlignment="Center"/>

                        <Border Height="1" Background="#334155" Margin="0,5"/>

                        <Grid ColumnDefinitions="*,*">
                            <StackPanel Grid.Column="0"
                                        HorizontalAlignment="Center"
                                        Spacing="4">
                                <TextBlock Text="💨 Ветер"
                                           Foreground="#64748B"
                                           FontSize="12"/>
                                <TextBlock Text="{Binding WindText}"
                                           Foreground="#F8FAFC"
                                           FontSize="16"
                                           FontWeight="Bold"/>
                            </StackPanel>
                            
                            <StackPanel Grid.Column="1"
                                        HorizontalAlignment="Center"
                                        Spacing="4">
                                <TextBlock Text="💧 Влажность"
                                           Foreground="#64748B"
                                           FontSize="12"/>
                                <TextBlock Text="{Binding HumidityText}"
                                           Foreground="#F8FAFC"
                                           FontSize="16"
                                           FontWeight="Bold"/>
                            </StackPanel>
                        </Grid>

                        <Border Height="1" Background="#334155"/>

                        <ListBox ItemsSource="{Binding HistoryItems}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 MaxHeight="140">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#334155"
                                            CornerRadius="8"
                                            Margin="0,3"
                                            Padding="10,8">
                                        <TextBlock Text="{Binding}"
                                                   Foreground="#E2E8F0"
                                              FontSize="12"/>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </Border>

                <Border Background="#1E293B"
                        CornerRadius="12"
                        Padding="12">
                    <TextBlock Text="{Binding DefaultCityText}"
                               Foreground="#64748B"
                               FontSize="11"
                               HorizontalAlignment="Center"/>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>

